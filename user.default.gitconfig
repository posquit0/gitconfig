[user]
  name = Byungjin Park
  email = posquit0.bj@gmail.com
  signingKey = 54180758

[commit]
  gpgsign = true

[tag]
  # Sign annotated tags by default (git >= 2.23).
  gpgsign = true

[push]
  gpgsign = if-asked

[gpg]
  format = openpgp
