# vim: set ft=gitconfig:
# gitconfig
#
# Maintained by Byungjin Park <posquit0.bj@gmail.com>
# https://www.posquit0.com/


[core]
  editor = nvim
[help]
  # Show the suggested command for a mistyped command and prompt for confirmation to run it.
  autocorrect = prompt
[column]
  # Show listing output (branch, tag, status) in columns when writing to a terminal.
  ui = auto
[color "branch"]
  current = yellow bold
  local   = green bold
  remote  = cyan bold
[color "diff"]
  meta       = yellow bold
  frag       = magenta bold
  old        = red bold
  new        = green bold
  whitespace = red reverse
[color "status"]
  added     = green bold
  changed   = yellow bold
  untracked = red bold


[init]
  # Override the default branch name.
  defaultBranch = main
[branch]
  # Show most recently used branches first.
  sort = -committerdate
[tag]
  # Sort tags as version numbers (v1.10 after v1.9, not after v1.1).
  sort = version:refname
[commit]
  # Show the diff of staged changes in the commit message editor.
  verbose = true
[merge]
  # Controls which merge tool is used by git-merge.
  tool = nvimdiff
  # Like diff3 but removes lines matching on both sides from the conflict region.
  conflictstyle = zdiff3
[push]
  # Push should only push current branch, not all branches.
  default = current
  # Enable `--follow-tags` option by default.
  followTags = true
  # Automatically set up remote tracking on the first push of a new branch.
  autoSetupRemote = true
[pull]
  rebase = true
[fetch]
  # Fetch all remotes by default.
  all = true
  # Remove remote-tracking refs that no longer exist on the remote.
  prune = true
  # Remove local tags that no longer exist on the remote.
  pruneTags = true
[rebase]
  # Automatically create a temporary stash entry before the operation begins, and apply it after the operation ends.
  autostash = true
  # Automatically reorder `fixup!`/`squash!` commits in interactive rebase.
  autoSquash = true
  # Update stacked branches that point into the rebased range.
  updateRefs = true
  # Abort interactive rebase if a commit line was accidentally removed from the todo list.
  missingCommitsCheck = error
[rerere]
  # Record and reuse previous conflict resolutions.
  enabled = true
  autoupdate = true
[diff]
  # Better hunk boundaries than the default Myers algorithm.
  algorithm = histogram
  # Use `i/` (index), `w/` (working tree) and `c/` (commit) prefixes instead of `a/` and `b/`.
  mnemonicPrefix = true
  # Detect renamed files (and copies).
  renames = copies
[status]
  # Enable the submodule summary and show a summary of commits for modified submodules
  submoduleSummary = true
[filter "lfs"]
  clean    = git-lfs clean -- %f
  smudge   = git-lfs smudge -- %f
  process  = git-lfs filter-process
  required = true

[include]
  path = ~/.gitconfig.d/aliases.gitconfig


###################################################
# Integrations
###################################################

[include]
  path = ~/.gitconfig.d/integration.delta.gitconfig
[include]
  path = ~/.gitconfig.d/integration.delta.themes.gitconfig


###################################################
# Users
###################################################

[include]
  path = ~/.gitconfig.d/user.default.gitconfig
