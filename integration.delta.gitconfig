# vim: set ft=gitconfig:
# integration.delta.gitconfig
#
# Maintained by Byungjin Park <posquit0.bj@gmail.com>
# https://www.posquit0.com/


[core]
  pager = delta

[delta]
  # Display line numbers next to the diff.
  line-numbers = true
  # Display diffs in side-by-side layout.
  side-by-side = true

  # Render commit hashes, file paths and line numbers as clickable hyperlinks.
  hyperlinks = true
  hyperlinks-file-link-format = "vscode://file/{path}:{line}"
  # Use `n` and `N` to move between diff sections.
  navigate = true


[interactive]
  # Pipe the diff through the shell command defined by this configuration on interactive command (such as git add --patch).
  diffFilter = delta --color-only

[diff]
  # Color moved lines differently from added/removed ones.
  colorMoved = default
